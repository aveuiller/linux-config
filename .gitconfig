[user]
    name = Antoine Veuiller
    #email = aveuiller@online.net
    email = aveuiller@gmail.com
[push]
	default = simple
[core]
	editor = vi
	excludesfile = ~/.gitignore_global
	pager = less
[credential]
	helper = store
[pull]
	rebase = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
